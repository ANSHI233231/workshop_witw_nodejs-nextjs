# Every setting the API needs (validated by src/config/environment.schema.ts). A new everyday
# setting lands in both files; advanced log overrides are listed in docs/how-it-works/platform/logging.md.

NODE_ENV=development
# Interface to listen on. Empty = all interfaces; 127.0.0.1 = only this machine (behind nginx).
HOST=
PORT=8030

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workshop_witw_db
DB_CONNECTION_LIMIT=10

# Proxies allowed to set X-Forwarded-For (the client IP). Default 'loopback' = a proxy on this
# machine (nginx). 'false' = never trust. Never 'true' on a server reachable directly.
TRUST_PROXY=

# Comma-separated list of frontend origins (manage, web)
CORS_ORIGIN=http://localhost:3041,http://localhost:3040

# Sign-in tokens (JWT): an access token and a refresh token, each with its own secret (at least 32
# random characters, different from each other; e.g. `openssl rand -hex 32`). Lifetimes: a number
# and a unit, s m h d.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# Domain of the sign-in cookies: one session shared by the API and every app (manage, web), so
# signing in or out on one app does it on all. The parent domain of the API and the apps,
# with a leading dot (e.g. .starter.local). Empty = the API's own host only (works only when
# every app is on that same host, e.g. localhost).
AUTH_COOKIE_DOMAIN=
# Put in front of the sign-in cookie names (stag_ gives stag_access_token, stag_refresh_token), so two copies
# of the project on the same parent domain (staging and production) keep separate sign-ins. Lowercase letters,
# digits and _ only. Must be the same in the apps' .env. Empty = access_token, refresh_token.
AUTH_COOKIE_PREFIX=

# Mail: capture = nothing is sent; every mail is recorded in mail_log (Sent Email Log in the console).
EMAIL_DRIVER=capture
MAIL_FROM=Workshop Witw <no-reply@example.com>

# Uploaded files: local = kept on this server's disk under STORAGE_LOCAL_ROOT (an absolute folder, or
# relative to apps/api; the folder is created when the first file is saved). Required. The default
# ../../storage is the storage/ folder at the repo root; .gitignore keeps it out of git on every machine.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage

# Background jobs (Console › Platform › Background Jobs): the API starts a worker that runs the scheduled
# jobs and queued runs (CLI commands, each in its own process). Off unless true. POLL: seconds between
# checks for waiting runs (1–60, default 5). MAX_PARALLEL: runs at once per worker (1–10, default 2).
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
WORKER_MAX_PARALLEL=2

# Public address of each app, used in links inside mails (password reset).
APP_URL_MANAGE=http://localhost:3041
APP_URL_WEB=http://localhost:3040

# Logging. Files go to apps/api/logs/: error.log, warning.log, info.log, debug.log (one per level),
# app.log (all saved levels in order) and access.log. Details: docs/how-it-works/platform/logging.md
#
# LOG_ENABLED  true = save logs. false or empty = save nothing.
# LOG_LEVELS   which levels to save, comma-separated: error, warning, info, debug.
#              Empty = error,warning,info. `info` includes every SQL query and a dump of each request.
# LOG_DB_LEVELS which levels are also saved in the database (table app_log, the manage Error Logs page),
#              comma-separated: error, warning, info, debug. Empty = error. Off only with LOG_ENABLED=false.
# LOG_INGEST_KEY secret the manage / web servers send with their error logs, at least 32
#              characters; the same value in each app's .env. Empty = the apps' errors are not saved here.
LOG_ENABLED=true
LOG_LEVELS=error,warning,info
LOG_DB_LEVELS=error
LOG_INGEST_KEY=

# System Logs page (manage): the log folders the API may read, app=folder, relative to apps/api.
# Apps: api, manage, web. Empty = only the API's own logs folder.
LOG_VIEWER_DIRS=api=logs,manage=../manage/logs,web=../web/logs

# Publish translations (manage › Languages › App Translations): the folders the API writes each app's <code>.json to,
# app=folder, relative to apps/api. Apps: manage, web. Empty = Publish is refused.
TRANSLATION_DIRS=manage=../manage/translations,web=../web/translations
