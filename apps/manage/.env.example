# Mirrors src/lib/config.ts. NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time: never put a secret here.

# The API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8030/api

# Where the error pages' Contact Support button goes: a full http(s):// URL, a path of this app starting
# with /, or empty (button shown, not clickable).
NEXT_PUBLIC_SUPPORT_URL=

# Domain of the language cookie (the console's EN / हिं choice), e.g. .starter.local so every app shares it.
# Empty = the console's own host only.
NEXT_PUBLIC_LOCALE_COOKIE_DOMAIN=

# Put in front of the sign-in cookie name (stag_ reads stag_access_token). Must be the same as the API's
# AUTH_COOKIE_PREFIX. Lowercase letters, digits and _ only; empty = access_token. Rebuild after changing it.
NEXT_PUBLIC_AUTH_COOKIE_PREFIX=

# Optional, dev only: local hostnames the dev server accepts (comma-separated, no scheme or port),
# when you open the app through a hostname instead of localhost.
DEV_ALLOWED_ORIGINS=

# Logging (server-only, never NEXT_PUBLIC_). Files go to this app's logs/ folder: error.log,
# warning.log, info.log, debug.log (one per level) and app.log (all saved levels in order).
# Browser console.*, crashes and this app's server errors are all saved. See
# docs/how-it-works/platform/frontend-logging.md
#
# LOG_ENABLED  true = save logs. false or empty = save nothing.
# LOG_LEVELS   which levels to save, comma-separated: error, warning, info, debug.
#              Empty = error,warning,info.
# LOG_INGEST_KEY secret sent with this app's error logs to the API, which saves them in the database (the
#              manage Error Logs page). The same value as LOG_INGEST_KEY in apps/api/.env, at least 32
#              characters. Empty = errors stay in this app's files only. Only errors are sent.
LOG_ENABLED=true
LOG_LEVELS=error,warning,info
LOG_INGEST_KEY=
